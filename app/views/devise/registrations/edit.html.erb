<div class="text-center mb-8">
  <h2 class="text-2xl font-bold text-dark">Редактирование профиля</h2>
</div>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-4" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="grid grid-cols-2 gap-4">
    <div class="space-y-1">
      <%= f.label :first_name, "Имя", class: "block text-sm font-medium text-dark" %>
      <%= f.text_field :first_name, autofocus: true, class: "w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-primary focus:border-primary transition-all text-dark" %>
    </div>
    <div class="space-y-1">
      <%= f.label :last_name, "Фамилия", class: "block text-sm font-medium text-dark" %>
      <%= f.text_field :last_name, class: "w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-primary focus:border-primary transition-all text-dark" %>
    </div>
  </div>

  <div class="space-y-1">
    <%= f.label :email, "Электронная почта", class: "block text-sm font-medium text-dark" %>
    <%= f.email_field :email, autocomplete: "email", class: "w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-primary focus:border-primary transition-all text-dark" %>
  </div>

  <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
    <div class="text-sm text-gray-500">Ожидается подтверждение для: <%= resource.unconfirmed_email %></div>
  <% end %>

  <div class="space-y-1">
    <%= f.label :phone, "Номер телефона", class: "block text-sm font-medium text-dark" %>
    <%= f.text_field :phone, class: "w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-primary focus:border-primary transition-all text-dark" %>
  </div>

  <div class="border-t border-gray-100 my-4 pt-4">
    <h3 class="text-lg font-bold text-dark mb-4">Смена пароля <span class="text-sm font-normal text-gray-400">(оставьте пустым, если не хотите менять)</span></h3>
    
    <div class="space-y-4">
      <div class="space-y-1">
        <%= f.label :password, "Новый пароль", class: "block text-sm font-medium text-dark" %>
        <%= f.password_field :password, autocomplete: "new-password", class: "w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-primary focus:border-primary transition-all text-dark" %>
      </div>

      <div class="space-y-1">
        <%= f.label :password_confirmation, "Подтверждение нового пароля", class: "block text-sm font-medium text-dark" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-primary focus:border-primary transition-all text-dark" %>
      </div>
    </div>
  </div>

  <div class="border-t border-gray-100 my-4 pt-4">
    <div class="space-y-1">
      <%= f.label :current_password, "Текущий пароль (нужен для сохранения изменений)", class: "block text-sm font-bold text-dark" %>
      <%= f.password_field :current_password, autocomplete: "current-password", class: "w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-primary focus:border-primary transition-all text-dark", required: true %>
    </div>
  </div>

  <div class="pt-4 flex gap-4">
    <%= link_to "Отмена", :back, class: "w-1/3 flex justify-center py-3 px-4 border border-gray-200 rounded-xl shadow-sm text-sm font-bold text-dark bg-white hover:bg-gray-50 transition-colors" %>
    <%= f.submit "Обновить профиль", class: "w-2/3 flex justify-center py-3 px-4 border border-transparent rounded-xl shadow-sm text-sm font-bold text-white bg-primary hover:bg-primary-dark focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary transition-colors cursor-pointer" %>
  </div>
<% end %>

<div class="mt-8 pt-8 border-t border-gray-100 text-center">
  <p class="text-sm text-gray-500 mb-2">Недовольны сервисом?</p>
  <%= button_to "Удалить аккаунт", registration_path(resource_name), data: { confirm: "Вы уверены? Это действие необратимо.", turbo_confirm: "Вы уверены? Это действие необратимо." }, method: :delete, class: "text-red-500 hover:text-red-700 font-medium text-sm transition-colors" %>
</div>
