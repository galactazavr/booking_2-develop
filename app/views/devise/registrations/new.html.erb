<div class="text-center mb-8">
  <h2 class="text-2xl font-bold text-dark">Создать аккаунт</h2>
  <p class="text-gray-500 mt-2 text-sm">Присоединяйтесь к Отели.ру</p>
</div>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-4" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <!-- Выбор роли (передаётся через параметр) -->
  <% role_value = params[:account_type] == 'supervisor' ? 'supervisor' : 'user' %>
  <%= f.hidden_field :role, value: role_value %>

  <div class="grid grid-cols-2 gap-4">
    <div class="space-y-1">
      <%= f.label :first_name, "Имя", class: "block text-sm font-medium text-dark" %>
      <%= f.text_field :first_name, autofocus: true, class: "w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-primary focus:border-primary transition-all text-dark placeholder-gray-400", placeholder: "Иван" %>
    </div>
    <div class="space-y-1">
      <%= f.label :last_name, "Фамилия", class: "block text-sm font-medium text-dark" %>
      <%= f.text_field :last_name, class: "w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-primary focus:border-primary transition-all text-dark placeholder-gray-400", placeholder: "Иванов" %>
    </div>
  </div>

  <div class="space-y-1">
    <%= f.label :email, "Электронная почта", class: "block text-sm font-medium text-dark" %>
    <%= f.email_field :email, autocomplete: "email", class: "w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-primary focus:border-primary transition-all text-dark placeholder-gray-400", placeholder: "example@mail.com" %>
  </div>

  <div class="space-y-1">
    <%= f.label :phone, "Номер телефона", class: "block text-sm font-medium text-dark" %>
    <%= f.text_field :phone, class: "w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-primary focus:border-primary transition-all text-dark placeholder-gray-400", placeholder: "+7 (999) 000-00-00" %>
  </div>

  <div class="space-y-1">
    <%= f.label :password, "Пароль", class: "block text-sm font-medium text-dark" %>
    <%= f.password_field :password, autocomplete: "new-password", class: "w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-primary focus:border-primary transition-all text-dark placeholder-gray-400", placeholder: "Минимум 6 символов" %>
  </div>

  <div class="space-y-1">
    <%= f.label :password_confirmation, "Подтвердите пароль", class: "block text-sm font-medium text-dark" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-primary focus:border-primary transition-all text-dark placeholder-gray-400" %>
  </div>

  <div class="pt-2">
    <%= f.submit params[:account_type] == 'supervisor' ? "Зарегистрироваться как партнер" : "Зарегистрироваться", class: "w-full flex justify-center py-3 px-4 border border-transparent rounded-xl shadow-sm text-sm font-bold text-white bg-primary hover:bg-primary-dark focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary transition-colors cursor-pointer" %>
  </div>
<% end %>

<div class="mt-6 text-center">
  <p class="text-sm text-gray-600">
    Уже есть аккаунт? 
    <%= link_to "Войти", new_session_path(resource_name), class: "font-medium text-primary hover:text-primary-dark transition-colors" %>
  </p>
</div>
