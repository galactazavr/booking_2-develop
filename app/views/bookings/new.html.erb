<!-- Оформление бронирования (Checkout) -->
<div class="bg-gray-50 min-h-screen pt-8 pb-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="mb-8 flex items-center">
      <%= link_to hotel_path(@hotel), class: "w-10 h-10 bg-white rounded-full flex items-center justify-center shadow-sm border border-gray-100 hover:bg-gray-50 transition-colors mr-4" do %>
        <svg class="w-5 h-5 text-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
      <% end %>
      <h1 class="text-3xl font-bold text-dark">Подтверждение бронирования</h1>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Левая колонка (Форма) -->
      <div class="lg:col-span-2 space-y-6">
        
        <!-- Ваши данные -->
        <div class="bg-white rounded-2xl p-8 border border-gray-100 shadow-sm">
          <h2 class="text-xl font-bold text-dark mb-6">Ваши данные</h2>
          <div class="flex items-center gap-4 bg-gray-50 rounded-xl p-4 border border-gray-100">
            <div class="w-12 h-12 rounded-full bg-primary-light flex items-center justify-center text-primary font-bold text-xl">
              <%= current_user.email[0].upcase %>
            </div>
            <div>
              <div class="font-bold text-dark text-lg"><%= current_user.full_name %></div>
              <div class="text-gray-500 text-sm"><%= current_user.email %></div>
            </div>
          </div>
        </div>

        <!-- Параметры поездки -->
        <div class="bg-white rounded-2xl p-8 border border-gray-100 shadow-sm">
          <h2 class="text-xl font-bold text-dark mb-6">Параметры поездки</h2>
          
          <%= form_with(model: @booking, local: true, class: "space-y-6") do |f| %>
            
            <% if @booking.errors.any? %>
              <div class="bg-red-50 text-red-800 p-4 rounded-xl border border-red-100">
                <h4 class="font-bold mb-2">Обнаружены ошибки:</h4>
                <ul class="list-disc pl-5 space-y-1">
                  <% @booking.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <%= f.hidden_field :room_id, value: @room.id %>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="space-y-1">
                <%= f.label :check_in, 'Дата заезда', class: "block text-sm font-bold text-dark" %>
                <%= f.date_field :check_in, class: 'w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-primary focus:border-primary text-dark', min: Date.today, required: true %>
              </div>
              <div class="space-y-1">
                <%= f.label :check_out, 'Дата выезда', class: "block text-sm font-bold text-dark" %>
                <%= f.date_field :check_out, class: 'w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-primary focus:border-primary text-dark', min: Date.tomorrow, required: true %>
              </div>
            </div>

            <div class="space-y-1">
              <%= f.label :guests_count, 'Количество гостей', class: "block text-sm font-bold text-dark" %>
              <%= f.number_field :guests_count, class: 'w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-primary focus:border-primary text-dark', min: 1, max: @room.capacity, required: true %>
              <p class="text-xs text-gray-500 mt-1">Максимум для этого номера: <%= @room.capacity %> чел.</p>
            </div>

            <div class="space-y-1">
              <%= f.label :special_requests, 'Особые пожелания (необязательно)', class: "block text-sm font-bold text-dark" %>
              <%= f.text_area :special_requests, class: 'w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-primary focus:border-primary text-dark placeholder-gray-400', rows: 3, placeholder: 'Поздний заезд, тихий номер...' %>
            </div>

            <div class="border-t border-gray-100 pt-6 mt-6">
              <%= f.submit 'Забронировать', class: 'w-full bg-primary hover:bg-primary-dark text-white font-bold py-4 px-6 rounded-xl transition-colors cursor-pointer text-lg' %>
              <p class="text-center text-xs text-gray-500 mt-4">Нажимая кнопку, вы соглашаетесь с правилами бронирования.</p>
            </div>
          <% end %>
        </div>

      </div>

      <!-- Правая колонка (Сводка отеля) -->
      <div class="lg:col-span-1">
        <div class="sticky top-28 bg-white rounded-2xl p-6 border border-gray-100 shadow-card">
          
          <div class="flex gap-4 border-b border-gray-100 pb-6 mb-6">
            <div class="w-24 h-24 bg-gray-100 rounded-xl overflow-hidden shrink-0">
              <% if @hotel.photos.attached? && @hotel.photos.first.present? %>
                <%= image_tag @hotel.photos.first, class: "w-full h-full object-cover" %>
              <% else %>
                <div class="w-full h-full flex items-center justify-center text-3xl">🏨</div>
              <% end %>
            </div>
            <div>
              <div class="text-sm text-gray-500 mb-1">Отель</div>
              <h3 class="font-bold text-dark text-lg leading-tight mb-1"><%= @hotel.name %></h3>
              <div class="flex items-center gap-1 text-sm text-dark font-medium">
                <svg class="w-3.5 h-3.5 text-primary" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                <%= @hotel.average_rating || 4.8 %>
              </div>
            </div>
          </div>

          <div class="mb-6">
            <h4 class="font-bold text-dark mb-4">Информация о номере</h4>
            <div class="text-gray-600 mb-1"><span class="font-medium text-dark">Тип:</span> <%= @room.room_type %></div>
            <div class="text-gray-600 mb-1"><span class="font-medium text-dark">Вместимость:</span> до <%= @room.capacity %> чел.</div>
            <div class="text-gray-600"><span class="font-medium text-dark">Площадь:</span> <%= @room.area %> м²</div>
          </div>

          <div class="border-t border-gray-100 pt-6">
            <h4 class="font-bold text-dark mb-4">Детали оплаты</h4>
            <div class="flex justify-between items-center mb-2 text-gray-600">
              <span><%= number_to_currency(@room.price_per_night, unit: '₽', format: '%n %u', precision: 0) %> x 1 ночь (пример)</span>
              <span><%= number_to_currency(@room.price_per_night, unit: '₽', format: '%n %u', precision: 0) %></span>
            </div>
            <div class="border-t border-gray-100 pt-4 mt-4 flex justify-between items-center">
              <span class="font-bold text-dark text-lg">Итого</span>
              <span class="font-bold text-dark text-xl"><%= number_to_currency(@room.price_per_night, unit: '₽', format: '%n %u', precision: 0) %></span>
            </div>
            <div class="text-right text-xs text-gray-400 mt-1">Финальная цена рассчитается после выбора дат</div>
          </div>

        </div>
      </div>

    </div>
  </div>
</div>
