<!-- Карточка бронирования -->
<% 
  status_colors = {
    'pending' => 'bg-yellow-50 text-yellow-700 border-yellow-200',
    'confirmed' => 'bg-green-50 text-green-700 border-green-200',
    'cancelled' => 'bg-red-50 text-red-700 border-red-200',
    'completed' => 'bg-gray-100 text-gray-700 border-gray-200'
  }
  status_labels = {
    'pending' => 'Ожидает подтверждения',
    'confirmed' => 'Подтверждено',
    'cancelled' => 'Отменено',
    'completed' => 'Завершено'
  }
%>
<div class="bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-card transition-shadow flex flex-col sm:flex-row overflow-hidden group">
  
  <!-- Изображение -->
  <div class="sm:w-1/3 h-48 sm:h-auto bg-gray-100 shrink-0 relative">
    <% if booking.room.hotel.photos.attached? && booking.room.hotel.photos.first.present? %>
      <%= image_tag booking.room.hotel.photos.first, class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" %>
    <% else %>
      <div class="w-full h-full flex items-center justify-center text-3xl">🏨</div>
    <% end %>
    
    <!-- Бейдж статуса поверх картинки на мобильных -->
    <div class="absolute top-3 left-3 sm:hidden">
      <span class="px-2.5 py-1 text-xs font-bold rounded-md border <%= status_colors[booking.status] %> shadow-sm backdrop-blur-md">
        <%= status_labels[booking.status] %>
      </span>
    </div>
  </div>

  <!-- Информация -->
  <div class="p-5 flex flex-col flex-grow">
    
    <div class="flex justify-between items-start mb-2">
      <div>
        <div class="text-xs text-gray-500 mb-1">Отель</div>
        <h3 class="font-bold text-lg text-dark leading-tight mb-1">
          <%= link_to booking.room.hotel.name, hotel_path(booking.room.hotel), class: "hover:text-primary transition-colors" %>
        </h3>
        <div class="text-sm text-gray-500 line-clamp-1"><%= booking.room.hotel.city %></div>
      </div>
      
      <!-- Бейдж статуса для десктопа -->
      <span class="hidden sm:inline-block px-2.5 py-1 text-xs font-bold rounded border <%= status_colors[booking.status] %>">
        <%= status_labels[booking.status] %>
      </span>
    </div>

    <div class="border-t border-gray-100 my-3"></div>

    <div class="flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-8 mb-4">
      <div>
        <div class="text-xs text-gray-400 uppercase tracking-wide font-bold">Даты</div>
        <div class="text-sm text-dark font-medium mt-0.5"><%= booking.check_in.strftime('%d.%m.%Y') %> – <%= booking.check_out.strftime('%d.%m.%Y') %></div>
      </div>
      <div>
        <div class="text-xs text-gray-400 uppercase tracking-wide font-bold">Номер</div>
        <div class="text-sm text-dark font-medium mt-0.5"><%= booking.room.name %></div>
      </div>
    </div>

    <div class="mt-auto flex items-center justify-between">
      <div>
        <div class="text-xl font-bold text-dark"><%= number_to_currency(booking.total_price, unit: '₽', format: '%n %u', precision: 0) %></div>
      </div>
      <%= link_to "Подробнее", booking_path(booking), class: "bg-white border border-gray-200 text-dark font-bold hover:border-dark px-4 py-2 rounded-lg text-sm transition-colors" %>
    </div>

  </div>
</div>
