<!-- Мои бронирования -->
<div class="bg-gray-50 min-h-screen pt-12 pb-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="mb-10">
      <h1 class="text-3xl md:text-4xl font-bold text-dark mb-2">Мои поездки</h1>
      <p class="text-gray-500 text-lg">История ваших бронирований</p>
    </div>

    <% if @bookings.any? %>
      
      <!-- Табы -->
      <div class="mb-8 border-b border-gray-200">
        <nav class="-mb-px flex space-x-8" aria-label="Tabs">
          <button id="tab-upcoming" class="border-primary text-primary whitespace-nowrap py-4 px-1 border-b-2 font-bold text-sm focus:outline-none cursor-pointer">Активные и будущие</button>
          <button id="tab-past" class="border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap py-4 px-1 border-b-2 font-bold text-sm transition-colors focus:outline-none cursor-pointer">Завершенные и прошедшие</button>
          <button id="tab-cancelled" class="border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap py-4 px-1 border-b-2 font-bold text-sm transition-colors focus:outline-none cursor-pointer">Отмененные</button>
        </nav>
      </div>

      <div class="space-y-6">
        <!-- Активные и будущие -->
        <div id="section-upcoming">
          <% upcoming = @bookings.select { |b| %w[pending confirmed].include?(b.status) } %>
          <% if upcoming.any? %>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
              <% upcoming.each do |booking| %>
                <%= render partial: 'bookings/booking_card', locals: { booking: booking } %>
              <% end %>
            </div>
          <% else %>
            <div class="bg-white border border-gray-100 rounded-2xl p-8 text-center shadow-sm">
              <p class="text-gray-500">Нет активных или предстоящих поездок.</p>
            </div>
          <% end %>
        </div>

        <!-- Завершенные и прошедшие -->
        <div id="section-past" class="hidden">
          <% past = @bookings.select { |b| b.status == 'completed' } %>
          <% if past.any? %>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
              <% past.each do |booking| %>
                <%= render partial: 'bookings/booking_card', locals: { booking: booking } %>
              <% end %>
            </div>
          <% else %>
            <div class="bg-white border border-gray-100 rounded-2xl p-8 text-center shadow-sm">
              <p class="text-gray-500">Нет завершенных поездок.</p>
            </div>
          <% end %>
        </div>

        <!-- Отмененные -->
        <div id="section-cancelled" class="hidden">
          <% cancelled = @bookings.select { |b| b.status == 'cancelled' } %>
          <% if cancelled.any? %>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 opacity-75">
              <% cancelled.each do |booking| %>
                <%= render partial: 'bookings/booking_card', locals: { booking: booking } %>
              <% end %>
            </div>
          <% else %>
            <div class="bg-white border border-gray-100 rounded-2xl p-8 text-center shadow-sm">
              <p class="text-gray-500">Нет отмененных поездок.</p>
            </div>
          <% end %>
        </div>
      </div>

      <div class="mt-12 flex justify-center">
        <%= paginate @bookings if @bookings.respond_to?(:total_pages) %>
      </div>

    <% else %>
      <!-- Пустое состояние -->
      <div class="bg-white rounded-3xl p-16 text-center shadow-sm border border-gray-100 max-w-2xl mx-auto mt-8">
        <div class="w-24 h-24 bg-gray-50 rounded-full flex items-center justify-center mx-auto mb-6">
          <svg class="w-12 h-12 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h2 class="text-2xl font-bold text-dark mb-4">У вас пока нет бронирований</h2>
        <p class="text-gray-500 mb-8 text-lg">Пора запланировать новое путешествие! Откройте для себя тысячи отелей.</p>
        <%= link_to "Начать поиск", root_path, class: "inline-block bg-primary hover:bg-primary-dark text-white font-bold px-8 py-4 rounded-xl transition-colors shadow-sm" %>
      </div>
    <% end %>

  </div>
</div>

<script>
  (function() {
    function initTabs() {
      const tabUpcoming = document.getElementById("tab-upcoming");
      const tabPast = document.getElementById("tab-past");
      const tabCancelled = document.getElementById("tab-cancelled");
      
      const sectionUpcoming = document.getElementById("section-upcoming");
      const sectionPast = document.getElementById("section-past");
      const sectionCancelled = document.getElementById("section-cancelled");

      const tabs = [tabUpcoming, tabPast, tabCancelled];
      const sections = [sectionUpcoming, sectionPast, sectionCancelled];

      function activateTab(index) {
        tabs.forEach((tab, i) => {
          if (!tab) return;
          if (i === index) {
            tab.classList.remove("border-transparent", "text-gray-500");
            tab.classList.add("border-primary", "text-primary");
          } else {
            tab.classList.remove("border-primary", "text-primary");
            tab.classList.add("border-transparent", "text-gray-500");
          }
        });

        sections.forEach((sec, i) => {
          if (!sec) return;
          if (i === index) {
            sec.classList.remove("hidden");
          } else {
            sec.classList.add("hidden");
          }
        });
      }

      if (tabUpcoming) {
        tabUpcoming.onclick = () => activateTab(0);
      }
      if (tabPast) {
        tabPast.onclick = () => activateTab(1);
      }
      if (tabCancelled) {
        tabCancelled.onclick = () => activateTab(2);
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initTabs);
    } else {
      initTabs();
    }
    document.addEventListener("turbo:load", initTabs);
  })();
</script>
