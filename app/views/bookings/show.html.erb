<!-- Детали бронирования -->
<% 
  status_colors = {
    'pending' => 'bg-yellow-50 text-yellow-700 border-yellow-200',
    'confirmed' => 'bg-green-50 text-green-700 border-green-200',
    'cancelled' => 'bg-red-50 text-red-700 border-red-200',
    'completed' => 'bg-gray-100 text-gray-700 border-gray-200'
  }
  status_labels = {
    'pending' => 'Ожидает подтверждения',
    'confirmed' => 'Подтверждено',
    'cancelled' => 'Отменено',
    'completed' => 'Завершено'
  }
%>

<div class="bg-gray-50 min-h-screen pt-8 pb-16">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Навигация назад -->
    <div class="mb-6">
      <%= link_to bookings_path, class: "inline-flex items-center text-sm font-medium text-gray-500 hover:text-dark transition-colors" do %>
        <svg class="w-4 h-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
        Ко всем поездкам
      <% end %>
    </div>

    <div class="bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden">
      
      <!-- Шапка билета -->
      <div class="p-8 border-b border-gray-100 relative overflow-hidden">
        <div class="absolute top-0 right-0 p-8 opacity-10">
          <svg class="w-32 h-32 text-primary" fill="currentColor" viewBox="0 0 24 24"><path d="M19 7h-3V6a4 4 0 0 0-8 0v1H5a1 1 0 0 0-1 1v11a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V8a1 1 0 0 0-1-1zm-9-1a2 2 0 0 1 4 0v1h-4V6zm8 13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V9h2v1a1 1 0 0 0 2 0V9h4v1a1 1 0 0 0 2 0V9h2v10z"/></svg>
        </div>
        
        <div class="relative z-10 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
          <div>
            <h1 class="text-3xl font-bold text-dark mb-2">Бронирование #<%= @booking.id %></h1>
            <div class="text-gray-500">Оформлено <%= l(@booking.created_at.to_date, format: :long) %></div>
          </div>
          <span class="px-3 py-1.5 text-sm font-bold rounded-lg border <%= status_colors[@booking.status] %>">
            <%= status_labels[@booking.status] %>
          </span>
        </div>
      </div>

      <!-- Основная инфа -->
      <div class="p-8">
        
        <!-- Карточка отеля внутри -->
        <div class="flex gap-6 items-center mb-8 bg-gray-50 p-4 rounded-2xl border border-gray-100">
          <div class="w-24 h-24 rounded-xl overflow-hidden shrink-0 bg-gray-200">
            <% if @booking.room.hotel.photos.attached? && @booking.room.hotel.photos.first.present? %>
              <%= image_tag @booking.room.hotel.photos.first, class: "w-full h-full object-cover" %>
            <% end %>
          </div>
          <div>
            <h3 class="text-xl font-bold text-dark mb-1"><%= @booking.room.hotel.name %></h3>
            <div class="text-gray-500 text-sm mb-2"><%= @booking.room.hotel.full_address %></div>
            <%= link_to "Посмотреть отель", hotel_path(@booking.room.hotel), class: "text-primary text-sm font-medium hover:underline" %>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
          <!-- Даты -->
          <div class="bg-white border border-gray-200 rounded-2xl p-6">
            <h4 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-4">Даты пребывания</h4>
            <div class="flex justify-between items-center relative">
              <div class="text-center">
                <div class="text-sm text-gray-500 mb-1">Заезд</div>
                <div class="text-xl font-bold text-dark"><%= @booking.check_in.strftime('%d.%m') %></div>
                <div class="text-xs text-gray-400"><%= @booking.check_in.strftime('%Y') %></div>
              </div>
              <div class="flex-1 px-4 flex items-center justify-center text-gray-300">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
              </div>
              <div class="text-center">
                <div class="text-sm text-gray-500 mb-1">Выезд</div>
                <div class="text-xl font-bold text-dark"><%= @booking.check_out.strftime('%d.%m') %></div>
                <div class="text-xs text-gray-400"><%= @booking.check_out.strftime('%Y') %></div>
              </div>
            </div>
            <div class="mt-4 pt-4 border-t border-gray-100 text-center text-sm font-medium text-dark">
              Всего ночей: <%= (@booking.check_out - @booking.check_in).to_i %>
            </div>
          </div>

          <!-- Гости и номер -->
          <div class="bg-white border border-gray-200 rounded-2xl p-6">
            <h4 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-4">Детали номера</h4>
            <div class="space-y-4">
              <div class="flex justify-between items-center">
                <span class="text-gray-500">Номер:</span>
                <span class="font-bold text-dark"><%= @booking.room.name %></span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-gray-500">Количество гостей:</span>
                <span class="font-bold text-dark"><%= @booking.guests_count %> чел.</span>
              </div>
              <% if @booking.special_requests.present? %>
                <div class="pt-4 border-t border-gray-100">
                  <span class="block text-gray-500 text-sm mb-1">Особые пожелания:</span>
                  <p class="text-dark text-sm"><%= @booking.special_requests %></p>
                </div>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Оплата -->
        <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100 flex flex-col md:flex-row justify-between items-center gap-4">
          <div>
            <div class="text-sm text-gray-500 mb-1">Итоговая стоимость</div>
            <div class="text-3xl font-bold text-dark"><%= number_to_currency(@booking.total_price, unit: '₽', format: '%n %u', precision: 0) %></div>
          </div>
          
          <!-- Кнопка отмены -->
          <% if @booking.pending? || @booking.confirmed? %>
            <% if policy(@booking).cancel? %>
              <%= button_to "Отменить бронирование", cancel_booking_path(@booking), method: :patch, data: { confirm: "Вы уверены, что хотите отменить бронирование?", turbo_confirm: "Вы уверены, что хотите отменить бронирование?" }, class: "bg-white border border-red-200 text-red-600 hover:bg-red-50 font-bold px-6 py-3 rounded-xl transition-colors" %>
            <% end %>
          <% end %>
        </div>

      </div>
    </div>
  </div>
</div>
