<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-dark">Все бронирования</h1>
    <p class="text-gray-500 mt-1">Панель администратора — полный список бронирований системы</p>
  </div>

  <!-- Панель фильтров -->
  <div class="bg-white rounded-2xl border border-gray-100 p-6 shadow-sm mb-8">
    <%= form_with url: admin_bookings_path, method: :get, local: true, class: "grid grid-cols-1 md:grid-cols-12 gap-4 items-end" do |f| %>
      <!-- Поиск по ключевому слову -->
      <div class="md:col-span-4 space-y-1">
        <%= f.label :query, 'Поиск гостя или отеля', class: "block text-xs font-bold text-gray-400 uppercase" %>
        <%= f.text_field :query, value: params[:query], placeholder: "ФИО, email или название отеля...", class: "w-full px-4 py-2.5 border border-gray-200 rounded-xl text-dark text-sm focus:ring-2 focus:ring-primary focus:border-primary" %>
      </div>

      <!-- Фильтр по статусу -->
      <div class="md:col-span-2 space-y-1">
        <%= f.label :status, 'Статус', class: "block text-xs font-bold text-gray-400 uppercase" %>
        <%= f.select :status, 
            options_for_select([
              ['Все статусы', ''],
              ['Ожидает', 'pending'],
              ['Подтверждено', 'confirmed'],
              ['Отменено', 'cancelled'],
              ['Завершено', 'completed']
            ], params[:status]), {},
            { class: "w-full px-4 py-2.5 border border-gray-200 rounded-xl text-dark text-sm bg-white focus:ring-2 focus:ring-primary focus:border-primary" } %>
      </div>

      <!-- Дата заезда с -->
      <div class="md:col-span-2 space-y-1">
        <%= f.label :start_date, 'Заезд с', class: "block text-xs font-bold text-gray-400 uppercase" %>
        <%= f.date_field :start_date, value: params[:start_date], class: "w-full px-4 py-2.5 border border-gray-200 rounded-xl text-dark text-sm focus:ring-2 focus:ring-primary focus:border-primary" %>
      </div>

      <!-- Дата выезда по -->
      <div class="md:col-span-2 space-y-1">
        <%= f.label :end_date, 'Выезд по', class: "block text-xs font-bold text-gray-400 uppercase" %>
        <%= f.date_field :end_date, value: params[:end_date], class: "w-full px-4 py-2.5 border border-gray-200 rounded-xl text-dark text-sm focus:ring-2 focus:ring-primary focus:border-primary" %>
      </div>

      <!-- Кнопки отправки / сброса -->
      <div class="md:col-span-2 flex gap-2">
        <%= f.submit 'Найти', class: "flex-1 bg-primary hover:bg-primary-dark text-white font-bold py-2.5 px-4 rounded-xl transition-colors text-sm cursor-pointer text-center" %>
        <%= link_to 'Сбросить', admin_bookings_path, class: "flex-1 bg-gray-50 hover:bg-gray-100 border border-gray-200 text-dark font-bold py-2.5 px-4 rounded-xl transition-colors text-sm text-center flex items-center justify-center" %>
      </div>
    <% end %>
  </div>

  <% if @bookings.any? %>
    <div class="bg-white rounded-2xl shadow-card overflow-hidden">
      <table class="min-w-full divide-y divide-gray-100">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">ID</th>
            <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Гость</th>
            <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Отель / Номер</th>
            <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Даты</th>
            <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Сумма</th>
            <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Статус</th>
            <th class="px-6 py-3 text-right text-xs font-bold text-gray-500 uppercase tracking-wider"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50">
          <% @bookings.each do |booking| %>
            <tr class="hover:bg-gray-50/50 transition-colors">
              <td class="px-6 py-4 text-sm font-medium text-dark">#<%= booking.id %></td>
              <td class="px-6 py-4 text-sm text-gray-600">
                <span class="font-medium"><%= booking.user.full_name %></span><br>
                <span class="text-xs text-gray-400"><%= booking.user.email %></span>
              </td>
              <td class="px-6 py-4 text-sm text-gray-600">
                <span class="font-medium text-dark"><%= booking.room.hotel.name %></span><br>
                <span class="text-xs text-gray-400"><%= booking.room.short_info %></span>
              </td>
              <td class="px-6 py-4 text-sm text-gray-600">
                <%= booking.check_in.strftime('%d.%m') %> — <%= booking.check_out.strftime('%d.%m.%Y') %>
              </td>
              <td class="px-6 py-4 text-sm font-semibold text-dark"><%= number_to_currency(booking.total_price, unit: '₽', format: '%n %u', precision: 0) %></td>
              <td class="px-6 py-4">
                <% status_colors = { 'pending' => 'bg-yellow-100 text-yellow-800', 'confirmed' => 'bg-green-100 text-green-800', 'cancelled' => 'bg-red-100 text-red-800', 'completed' => 'bg-blue-100 text-blue-800' } %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= status_colors[booking.status] %>">
                  <%= booking.status_label %>
                </span>
              </td>
              <td class="px-6 py-4 text-right">
                <%= link_to 'Подробнее', admin_booking_path(booking), class: 'text-primary hover:text-primary-dark text-sm font-medium' %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="mt-6 flex justify-center">
      <%= paginate @bookings, theme: 'tailwind' %>
    </div>
  <% else %>
    <div class="bg-white rounded-2xl shadow-card p-12 text-center">
      <h3 class="text-lg font-semibold text-gray-500">
        <%= (params[:query].present? || params[:status].present? || params[:start_date].present? || params[:end_date].present?) ? 'Ничего не найдено по вашему запросу' : 'Бронирований в системе пока нет' %>
      </h3>
      <p class="text-gray-400 mt-2 text-sm">Попробуйте изменить параметры фильтрации или сбросить их.</p>
    </div>
  <% end %>
</div>
