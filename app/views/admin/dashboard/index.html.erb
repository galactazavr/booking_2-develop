<div>
    

    <div class="mb-10">
      <h1 class="text-3xl font-bold text-dark">Модерация объектов</h1>
      <p class="text-gray-500 mt-1">Отели и апартаменты, ожидающие подтверждения</p>
    </div>

    <!-- Раздел Отелей -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold text-dark mb-4 flex items-center gap-2">
        🏨 Отели <span class="bg-gray-100 text-gray-800 text-xs px-2.5 py-1 rounded-full font-bold"><%= @hotels.count %></span>
      </h2>
      <div class="bg-white shadow-sm rounded-2xl border border-gray-100 overflow-hidden">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-gray-50 border-b border-gray-100 text-gray-500 text-sm uppercase">
              <th class="p-4 font-bold tracking-wider">ID / Название</th>
              <th class="p-4 font-bold tracking-wider">Город</th>
              <th class="p-4 font-bold tracking-wider">Владелец</th>
              <th class="p-4 font-bold tracking-wider">Действия</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% if @hotels.any? %>
              <% @hotels.each do |hotel| %>
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="p-4">
                    <div class="font-bold text-dark cursor-pointer" onclick="document.getElementById('hotel-details-<%= hotel.id %>').classList.toggle('hidden')">
                      <%= hotel.name %>
                      <span class="text-xs text-blue-500 ml-1">▼ подробнее</span>
                    </div>
                    <div class="text-xs text-gray-400">#<%= hotel.id %> · <%= hotel.hotel_type %></div>
                  </td>
                  <td class="p-4 text-sm text-gray-600"><%= hotel.city %></td>
                  <td class="p-4 text-sm text-gray-600"><%= hotel.user&.email || 'Неизвестно' %></td>
                  <td class="p-4 flex gap-2">
                    <%= button_to "Одобрить", admin_approve_hotel_path(hotel), method: :patch, class: "bg-green-100 text-green-700 hover:bg-green-200 px-4 py-1.5 rounded-lg text-sm font-bold transition-colors" %>
                    <%= button_to "Отклонить", admin_reject_hotel_path(hotel), method: :patch, class: "bg-red-100 text-red-700 hover:bg-red-200 px-4 py-1.5 rounded-lg text-sm font-bold transition-colors", data: { confirm: "Точно отклонить?" } %>
                  </td>
                </tr>
                <tr id="hotel-details-<%= hotel.id %>" class="hidden">
                  <td colspan="4" class="px-4 pb-4">
                    <div class="bg-slate-50 rounded-xl p-4 border border-slate-200 text-sm space-y-2">
                      <div class="grid grid-cols-2 gap-4">
                        <div>
                          <span class="font-semibold text-gray-700">Адрес:</span>
                          <span class="text-gray-600"><%= hotel.full_address %></span>
                        </div>
                        <div>
                          <span class="font-semibold text-gray-700">Тип:</span>
                          <span class="text-gray-600"><%= hotel.hotel_type %></span>
                        </div>
                        <div>
                          <span class="font-semibold text-gray-700">Цена от:</span>
                          <span class="text-gray-600"><%= number_to_currency(hotel.base_price_per_night, unit: '₽', format: '%n %u') %> / ночь</span>
                        </div>
                        <div>
                          <span class="font-semibold text-gray-700">Рейтинг:</span>
                          <span class="text-gray-600"><%= hotel.average_rating %> ⭐</span>
                        </div>
                        <div>
                          <span class="font-semibold text-gray-700">Доступность:</span>
                          <span class="text-gray-600"><%= hotel.availability_label %></span>
                        </div>
                        <div>
                          <span class="font-semibold text-gray-700">Сеть:</span>
                          <span class="text-gray-600"><%= hotel.chain.present? ? hotel.chain : '—' %></span>
                        </div>
                      </div>
                      <% if hotel.description.present? %>
                        <div class="pt-2 border-t border-slate-200">
                          <span class="font-semibold text-gray-700">Описание:</span>
                          <p class="text-gray-600 mt-1"><%= hotel.description %></p>
                        </div>
                      <% end %>
                      <% if hotel.rooms.any? %>
                        <div class="pt-2 border-t border-slate-200">
                          <span class="font-semibold text-gray-700">Номера (<%= hotel.rooms.count %>):</span>
                          <ul class="mt-1 space-y-1">
                            <% hotel.rooms.each do |room| %>
                              <li class="text-gray-600">• <%= room.name %> — <%= room.room_type %>, <%= room.capacity %> гост., <%= number_to_currency(room.price_per_night, unit: '₽', format: '%n %u') %></li>
                            <% end %>
                          </ul>
                        </div>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="4" class="p-8 text-center text-gray-500">Нет отелей на модерации. Все чисто! ✨</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Раздел Апартаментов -->
    <div>
      <h2 class="text-2xl font-bold text-dark mb-4 flex items-center gap-2">
        🏠 Апартаменты и Жилье <span class="bg-gray-100 text-gray-800 text-xs px-2.5 py-1 rounded-full font-bold"><%= @properties.count %></span>
      </h2>
      <div class="bg-white shadow-sm rounded-2xl border border-gray-100 overflow-hidden">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-gray-50 border-b border-gray-100 text-gray-500 text-sm uppercase">
              <th class="p-4 font-bold tracking-wider">ID / Название</th>
              <th class="p-4 font-bold tracking-wider">Тип / Город</th>
              <th class="p-4 font-bold tracking-wider">Владелец</th>
              <th class="p-4 font-bold tracking-wider">Действия</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% if @properties.any? %>
              <% @properties.each do |property| %>
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="p-4">
                    <div class="font-bold text-dark"><%= property.name %></div>
                    <div class="text-xs text-gray-400">#<%= property.id %></div>
                  </td>
                  <td class="p-4 text-sm text-gray-600">
                    <div class="font-medium text-gray-800"><%= property.property_type %></div>
                    <div class="text-xs text-gray-500"><%= property.city %></div>
                  </td>
                  <td class="p-4 text-sm text-gray-600"><%= property.user&.email || 'Неизвестно' %></td>
                  <td class="p-4 flex gap-2">
                    <%= button_to "Одобрить", admin_approve_property_path(property), method: :patch, class: "bg-green-100 text-green-700 hover:bg-green-200 px-4 py-1.5 rounded-lg text-sm font-bold transition-colors" %>
                    <%= button_to "Отклонить", admin_reject_property_path(property), method: :patch, class: "bg-red-100 text-red-700 hover:bg-red-200 px-4 py-1.5 rounded-lg text-sm font-bold transition-colors", data: { confirm: "Точно отклонить?" } %>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="4" class="p-8 text-center text-gray-500">Нет апартаментов на модерации. Все чисто! ✨</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- История действий -->
    <div class="mt-16 border-t border-gray-100 pt-10">
      <h2 class="text-2xl font-bold text-dark mb-2 flex items-center gap-2">
        ⏳ История действий
      </h2>
      <p class="text-gray-500 text-sm mb-6">Последние обработанные и удаленные объекты (до 15 записей)</p>

      <!-- Фильтры истории -->
      <form action="<%= admin_root_path %>" method="get" class="bg-gray-50 p-4 rounded-xl border border-gray-100 flex flex-wrap gap-4 items-end mb-6 text-sm">
        <div class="flex-1 min-w-[200px]">
          <label for="city" class="block text-xs font-bold text-gray-500 uppercase mb-1">Город</label>
          <input type="text" name="city" id="city" value="<%= params[:city] %>" class="w-full px-3 py-2 border border-gray-200 rounded-lg focus:outline-none focus:border-primary" placeholder="Например, Сочи или Москва">
        </div>
        <div class="w-48">
          <label for="hotel_type" class="block text-xs font-bold text-gray-500 uppercase mb-1">Тип отеля</label>
          <select name="hotel_type" id="hotel_type" class="w-full px-3 py-2 border border-gray-200 rounded-lg focus:outline-none focus:border-primary">
            <option value="">Все типы</option>
            <% %w[Отель База\ отдыха Апарт-отель Гостевой\ дом Хостел Санаторий Глэмпинг Другое].each do |type| %>
              <option value="<%= type %>" <%= 'selected' if params[:hotel_type] == type %>><%= type %></option>
            <% end %>
          </select>
        </div>
        <div class="w-48">
          <label for="property_type" class="block text-xs font-bold text-gray-500 uppercase mb-1">Тип жилья</label>
          <select name="property_type" id="property_type" class="w-full px-3 py-2 border border-gray-200 rounded-lg focus:outline-none focus:border-primary">
            <option value="">Все типы</option>
            <% %w[Квартира Апартаменты Дом Комната Таунхаус].each do |type| %>
              <option value="<%= type %>" <%= 'selected' if params[:property_type] == type %>><%= type %></option>
            <% end %>
          </select>
        </div>
        <div class="flex gap-2">
          <button type="submit" class="bg-primary hover:bg-primary/90 text-white font-bold px-4 py-2 rounded-lg transition-colors">Применить</button>
          <% if params[:city].present? || params[:hotel_type].present? || params[:property_type].present? %>
            <a href="<%= admin_root_path %>" class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold px-4 py-2 rounded-lg transition-colors flex items-center justify-center">Сбросить</a>
          <% end %>
        </div>
      </form>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        
        <!-- История Отелей -->
        <div>
          <h3 class="text-lg font-bold text-dark mb-4 flex items-center gap-2">🏨 Отели</h3>
          <div class="bg-white shadow-sm rounded-2xl border border-gray-100 overflow-hidden">
            <table class="w-full text-left border-collapse text-sm">
              <thead>
                <tr class="bg-gray-50 border-b border-gray-100 text-gray-500 uppercase text-xs">
                  <th class="p-4 font-bold tracking-wider">Объект</th>
                  <th class="p-4 font-bold tracking-wider">Статус</th>
                  <th class="p-4 font-bold tracking-wider">Дата решения</th>
                  <th class="p-4 font-bold tracking-wider">Действия</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                <% if @history_hotels.any? %>
                  <% @history_hotels.each do |hotel| %>
                    <tr class="hover:bg-gray-50/50 transition-colors">
                      <td class="p-4">
                        <div class="font-bold text-dark"><%= hotel.name %></div>
                        <div class="text-xs text-gray-400">#<%= hotel.id %> · <%= hotel.city %></div>
                      </td>
                      <td class="p-4">
                        <% if hotel.status == 'active' %>
                          <span class="px-2.5 py-1 text-xs font-bold rounded-full bg-green-50 text-green-700 border border-green-100">Одобрен</span>
                        <% elsif hotel.status == 'deleted' %>
                          <span class="px-2.5 py-1 text-xs font-bold rounded-full bg-red-50 text-red-700 border border-red-100">Удален (Снесен)</span>
                          <% if hotel.deletion_reason.present? %>
                            <div class="text-[10px] text-gray-400 mt-1 max-w-[150px] break-words">Причина: <%= hotel.deletion_reason %></div>
                          <% end %>
                        <% else %>
                          <span class="px-2.5 py-1 text-xs font-bold rounded-full bg-yellow-50 text-yellow-700 border border-yellow-100">Отклонен</span>
                        <% end %>
                      </td>
                      <td class="p-4 text-xs text-gray-500 font-mono">
                        <%= l(hotel.updated_at, format: '%d.%m.%Y %H:%M') %>
                      </td>
                      <td class="p-4">
                        <% if hotel.status == 'active' %>
                          <button type="button" class="text-red-600 hover:text-red-900 font-bold text-xs bg-red-50 hover:bg-red-100 px-2.5 py-1 rounded transition-colors" onclick="openDemolishModal('hotel', <%= hotel.id %>, '<%= escape_javascript(hotel.name) %>')">Снести</button>
                          <%= form_with url: hotel_path(hotel), method: :delete, id: "demolish-form-hotel-#{hotel.id}", local: true, class: 'hidden' do |f| %>
                            <input type="hidden" name="deletion_reason" id="demolish-reason-hotel-<%= hotel.id %>">
                          <% end %>
                        <% else %>
                          <span class="text-gray-400">—</span>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                <% else %>
                  <tr>
                    <td colspan="4" class="p-6 text-center text-gray-400 text-xs">История пуста</td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- История Апартаментов -->
        <div>
          <h3 class="text-lg font-bold text-dark mb-4 flex items-center gap-2">🏠 Апартаменты и Жилье</h3>
          <div class="bg-white shadow-sm rounded-2xl border border-gray-100 overflow-hidden">
            <table class="w-full text-left border-collapse text-sm">
              <thead>
                <tr class="bg-gray-50 border-b border-gray-100 text-gray-500 uppercase text-xs">
                  <th class="p-4 font-bold tracking-wider">Объект</th>
                  <th class="p-4 font-bold tracking-wider">Статус</th>
                  <th class="p-4 font-bold tracking-wider">Дата решения</th>
                  <th class="p-4 font-bold tracking-wider">Действия</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                <% if @history_properties.any? %>
                  <% @history_properties.each do |property| %>
                    <tr class="hover:bg-gray-50/50 transition-colors">
                      <td class="p-4">
                        <div class="font-bold text-dark"><%= property.name %></div>
                        <div class="text-xs text-gray-400">#<%= property.id %> · <%= property.city %></div>
                      </td>
                      <td class="p-4">
                        <% if property.status == 'active' %>
                          <span class="px-2.5 py-1 text-xs font-bold rounded-full bg-green-50 text-green-700 border border-green-100">Одобрен</span>
                        <% elsif property.status == 'deleted' %>
                          <span class="px-2.5 py-1 text-xs font-bold rounded-full bg-red-50 text-red-700 border border-red-100">Удален (Снесен)</span>
                          <% if property.deletion_reason.present? %>
                            <div class="text-[10px] text-gray-400 mt-1 max-w-[150px] break-words">Причина: <%= property.deletion_reason %></div>
                          <% end %>
                        <% else %>
                          <span class="px-2.5 py-1 text-xs font-bold rounded-full bg-yellow-50 text-yellow-700 border border-yellow-100">Отклонен</span>
                        <% end %>
                      </td>
                      <td class="p-4 text-xs text-gray-500 font-mono">
                        <%= l(property.updated_at, format: '%d.%m.%Y %H:%M') %>
                      </td>
                      <td class="p-4">
                        <% if property.status == 'active' %>
                          <button type="button" class="text-red-600 hover:text-red-900 font-bold text-xs bg-red-50 hover:bg-red-100 px-2.5 py-1 rounded transition-colors" onclick="openDemolishModal('property', <%= property.id %>, '<%= escape_javascript(property.name) %>')">Снести</button>
                          <%= form_with url: property_path(property), method: :delete, id: "demolish-form-property-#{property.id}", local: true, class: 'hidden' do |f| %>
                            <input type="hidden" name="deletion_reason" id="demolish-reason-property-<%= property.id %>">
                          <% end %>
                        <% else %>
                          <span class="text-gray-400">—</span>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                <% else %>
                  <tr>
                    <td colspan="4" class="p-6 text-center text-gray-400 text-xs">История пуста</td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>

<!-- Модальное окно для сноса/удаления объекта -->
<div id="demolish-modal" class="fixed inset-0 z-50 flex items-center justify-center hidden">
  <!-- Backdrop -->
  <div class="fixed inset-0 bg-black/55 backdrop-blur-sm" onclick="closeDemolishModal()"></div>
  
  <!-- Content -->
  <div class="bg-white rounded-2xl shadow-xl border border-gray-100 max-w-md w-full p-6 relative z-10 mx-4">
    <h3 class="text-xl font-bold text-dark mb-2">Снести объект</h3>
    <p class="text-sm text-gray-500 mb-6">
      Вы собираетесь полностью удалить объект <strong id="demolish-object-name" class="text-dark"></strong>. Все активные бронирования клиентов будут отменены с указанием причины.
    </p>
    
    <div class="mb-6">
      <label for="deletion_reason" class="block text-sm font-bold text-gray-700 mb-2">Укажите причину удаления:</label>
      <select id="deletion-reason-select" class="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm mb-3 focus:outline-none focus:border-primary" onchange="handleReasonSelect(this.value)">
        <option value="Отель/жилье полностью прекратило свою работу или было снесено">Отель/жилье полностью прекратило свою работу или было снесено</option>
        <option value="Нарушение правил размещения и условий оферты">Нарушение правил размещения и условий оферты</option>
        <option value="Дубликат объекта или предоставление неверных данных">Дубликат объекта или предоставление неверных данных</option>
        <option value="custom">Указать свою причину...</option>
      </select>
      <textarea id="deletion-reason-text" rows="3" class="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-primary hidden" placeholder="Введите подробную причину удаления..."></textarea>
    </div>
    
    <div class="flex gap-3 justify-end">
      <button type="button" class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-lg transition-colors" onclick="closeDemolishModal()">Отмена</button>
      <button type="button" class="px-4 py-2 text-sm font-bold text-white bg-red-600 hover:bg-red-700 rounded-lg transition-colors" onclick="submitDemolish()">Снести объект</button>
    </div>
  </div>
</div>

<script>
  let currentTargetType = '';
  let currentTargetId = '';

  function openDemolishModal(type, id, name) {
    currentTargetType = type;
    currentTargetId = id;
    document.getElementById('demolish-object-name').textContent = name;
    
    // Reset select & textarea
    const select = document.getElementById('deletion-reason-select');
    select.value = select.options[0].value;
    
    const textarea = document.getElementById('deletion-reason-text');
    textarea.value = select.value;
    textarea.classList.add('hidden');
    
    // Show modal
    document.getElementById('demolish-modal').classList.remove('hidden');
  }
  
  function closeDemolishModal() {
    document.getElementById('demolish-modal').classList.add('hidden');
  }
  
  function handleReasonSelect(value) {
    const textarea = document.getElementById('deletion-reason-text');
    if (value === 'custom') {
      textarea.value = '';
      textarea.classList.remove('hidden');
      textarea.focus();
    } else {
      textarea.value = value;
      textarea.classList.add('hidden');
    }
  }

  function submitDemolish() {
    const textarea = document.getElementById('deletion-reason-text');
    const reason = textarea.value.trim();
    if (!reason) {
      alert('Пожалуйста, укажите причину удаления');
      return;
    }
    
    // Set reason in the hidden input of the selected form
    const reasonInput = document.getElementById(`demolish-reason-${currentTargetType}-${currentTargetId}`);
    if (reasonInput) {
      reasonInput.value = reason;
      
      // Submit the form
      const form = document.getElementById(`demolish-form-${currentTargetType}-${currentTargetId}`);
      if (form) {
        form.submit();
      }
    }
  }
</script>
