<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-dark">Бронирования моих объектов</h1>
    <p class="text-gray-500 mt-1">Управляйте бронированиями ваших отелей</p>
  </div>

  <% if @bookings.any? %>
    <div class="bg-white rounded-2xl shadow-card overflow-hidden">
      <table class="min-w-full divide-y divide-gray-100">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">ID</th>
            <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Гость</th>
            <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Отель / Номер</th>
            <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Даты</th>
            <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Сумма</th>
            <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Статус</th>
            <th class="px-6 py-3 text-right text-xs font-bold text-gray-500 uppercase tracking-wider">Действия</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50">
          <% @bookings.each do |booking| %>
            <tr class="hover:bg-gray-50/50 transition-colors">
              <td class="px-6 py-4 text-sm font-medium text-dark">#<%= booking.id %></td>
              <td class="px-6 py-4 text-sm text-gray-600"><%= booking.user.full_name %></td>
              <td class="px-6 py-4 text-sm text-gray-600">
                <span class="font-medium text-dark"><%= booking.room.hotel.name %></span><br>
                <span class="text-xs text-gray-400"><%= booking.room.short_info %></span>
              </td>
              <td class="px-6 py-4 text-sm text-gray-600">
                <%= booking.check_in.strftime('%d.%m.%Y') %> — <%= booking.check_out.strftime('%d.%m.%Y') %>
              </td>
              <td class="px-6 py-4 text-sm font-semibold text-dark"><%= number_to_currency(booking.total_price, unit: '₽', format: '%n %u', precision: 0) %></td>
              <td class="px-6 py-4">
                <% status_colors = { 'pending' => 'bg-yellow-100 text-yellow-800', 'confirmed' => 'bg-green-100 text-green-800', 'cancelled' => 'bg-red-100 text-red-800', 'completed' => 'bg-blue-100 text-blue-800' } %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= status_colors[booking.status] %>">
                  <%= booking.status_label %>
                </span>
              </td>
              <td class="px-6 py-4 text-right space-x-2">
                <%= link_to 'Подробнее', supervisor_booking_path(booking), class: 'text-primary hover:text-primary-dark text-sm font-medium align-middle' %>
                <% if booking.pending? %>
                  <%= button_to 'Подтвердить', confirm_supervisor_booking_path(booking), method: :patch, class: 'inline-block text-green-600 hover:text-green-800 text-sm font-medium bg-transparent border-0 cursor-pointer p-0 align-middle', form: { class: 'inline' } %>
                  <button onclick="openCancelModal(<%= booking.id %>)" class="inline-block text-red-600 hover:text-red-800 text-sm font-medium bg-transparent border-0 cursor-pointer p-0 align-middle">
                    Отклонить
                  </button>
                <% elsif booking.confirmed? %>
                  <button onclick="openCancelModal(<%= booking.id %>)" class="inline-block text-red-600 hover:text-red-800 text-sm font-medium bg-transparent border-0 cursor-pointer p-0 align-middle">
                    Отменить
                  </button>
                <% end %>

                <% if booking.pending? || booking.confirmed? %>
                  <!-- Красивое модальное окно для конкретного бронирования -->
                  <div id="cancel-modal-<%= booking.id %>" class="fixed inset-0 z-50 flex items-center justify-center hidden text-left">
                    <!-- Backdrop overlay -->
                    <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" onclick="closeCancelModal(<%= booking.id %>)"></div>
                    
                    <!-- Modal box -->
                    <div class="relative bg-white rounded-3xl p-8 max-w-md w-full mx-4 shadow-2xl border border-gray-100 text-left animate-in fade-in zoom-in duration-200">
                      <div class="w-12 h-12 bg-red-50 text-red-500 rounded-full flex items-center justify-center mb-4 border border-red-100">
                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                           <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                      </div>
                      <h3 class="text-xl font-bold text-dark mb-2">
                        <%= booking.pending? ? 'Отклонить запрос?' : 'Отменить бронирование?' %>
                      </h3>
                      <p class="text-gray-500 text-sm mb-4 leading-relaxed">
                        Укажите причину для отправки клиенту. Она отобразится в его личном кабинете.
                      </p>
                      
                      <%= form_with url: cancel_supervisor_booking_path(booking), method: :patch, local: true, class: "space-y-4" do %>
                        <div>
                          <label class="block text-xs font-bold text-gray-400 uppercase mb-2">Выберите причину</label>
                          <select id="cancel_reason_preset_<%= booking.id %>" class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-primary text-dark text-sm bg-white" onchange="toggleCustomReasonIndex(this, <%= booking.id %>)">
                            <option value="Нет свободных номеров на выбранные даты">Нет свободных номеров на выбранные даты</option>
                            <option value="Технические неполадки / Ремонт в корпусе">Технические неполадки / Ремонт в корпусе</option>
                            <option value="Форс-мажорные обстоятельства">Форс-мажорные обстоятельства</option>
                            <option value="other">Другая причина...</option>
                          </select>
                        </div>

                        <div id="custom_reason_wrapper_<%= booking.id %>" class="hidden">
                          <label class="block text-xs font-bold text-gray-400 uppercase mb-2">Свой вариант</label>
                          <textarea name="cancellation_reason" id="custom_reason_input_<%= booking.id %>" rows="3" class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-primary text-dark text-sm placeholder-gray-400" placeholder="Укажите причину отмены..."></textarea>
                        </div>

                        <input type="hidden" name="cancellation_reason" id="final_reason_input_<%= booking.id %>" value="Нет свободных номеров на выбранные даты">

                        <div class="flex gap-3 pt-2">
                          <button type="button" onclick="closeCancelModal(<%= booking.id %>)" class="flex-1 bg-gray-50 hover:bg-gray-100 text-dark font-bold py-3 px-4 rounded-xl transition-colors border border-gray-200 text-sm cursor-pointer text-center">
                            Назад
                          </button>
                          <button type="submit" class="flex-1 bg-red-600 hover:bg-red-700 text-white font-bold py-3 px-4 rounded-xl transition-colors text-sm cursor-pointer">
                            Подтвердить отмену
                          </button>
                        </div>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="mt-6 flex justify-center">
      <%= paginate @bookings %>
    </div>
  <% else %>
    <div class="bg-white rounded-2xl shadow-card p-12 text-center">
      <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
      <h3 class="text-lg font-semibold text-gray-500">Бронирований пока нет</h3>
      <p class="text-gray-400 mt-1">Когда гости начнут бронировать ваши объекты, они появятся здесь.</p>
    </div>
  <% end %>
</div>

<script>
  function openCancelModal(id) {
    const modal = document.getElementById('cancel-modal-' + id);
    if (modal) {
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeCancelModal(id) {
    const modal = document.getElementById('cancel-modal-' + id);
    if (modal) {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }
  }

  function toggleCustomReasonIndex(select, id) {
    const wrapper = document.getElementById('custom_reason_wrapper_' + id);
    const customInput = document.getElementById('custom_reason_input_' + id);
    const finalInput = document.getElementById('final_reason_input_' + id);
    
    if (select.value === 'other') {
      wrapper.classList.remove('hidden');
      customInput.required = true;
      finalInput.name = '';
      customInput.name = 'cancellation_reason';
    } else {
      wrapper.classList.add('hidden');
      customInput.required = false;
      finalInput.name = 'cancellation_reason';
      customInput.name = '';
      finalInput.value = select.value;
    }
  }
</script>
