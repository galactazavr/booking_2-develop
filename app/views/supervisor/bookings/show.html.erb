<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <!-- Навигация -->
  <div class="mb-6">
    <%= link_to '← Назад к бронированиям', supervisor_bookings_path, class: 'text-primary hover:text-primary-dark font-medium text-sm' %>
  </div>

  <!-- Карточка бронирования -->
  <div class="bg-white rounded-2xl shadow-card overflow-hidden">
    <!-- Заголовок -->
    <div class="px-8 py-6 border-b border-gray-100 flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold text-dark">Бронирование #<%= @booking.id %></h1>
        <p class="text-gray-500 text-sm mt-1">Создано: <%= @booking.created_at.strftime('%d.%m.%Y в %H:%M') %></p>
      </div>
      <% status_colors = { 
        'pending' => 'bg-yellow-100 text-yellow-800', 
        'confirmed' => 'bg-green-100 text-green-800', 
        'cancelled' => 'bg-red-100 text-red-800', 
        'completed' => 'bg-blue-100 text-blue-800' 
      } %>
      <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-semibold <%= status_colors[@booking.status] %>">
        <%= @booking.status_label %>
      </span>
    </div>

    <!-- Отображение причины отмены для менеджера, если отменено -->
    <% if @booking.cancelled? && @booking.cancellation_reason.present? %>
      <div class="bg-red-50/50 border-b border-red-100 p-8 flex items-start gap-4">
        <div class="w-10 h-10 rounded-full bg-red-100 flex items-center justify-center text-red-600 shrink-0">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        </div>
        <div>
          <h4 class="font-bold text-red-800 mb-1">Причина отмены</h4>
          <p class="text-red-700 text-sm"><%= @booking.cancellation_reason %></p>
        </div>
      </div>
    <% end %>

    <!-- Детали в сетке -->
    <div class="p-8 grid grid-cols-1 md:grid-cols-2 gap-8 border-b border-gray-100">
      <!-- Информация о госте -->
      <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
        <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-4">Информация о госте</h3>
        <div class="space-y-2">
          <div class="flex justify-between items-center text-sm">
            <span class="text-gray-500">Профиль:</span>
            <span class="font-bold text-dark"><%= @booking.user.full_name %></span>
          </div>
          <div class="flex justify-between items-center text-sm">
            <span class="text-gray-500">Email:</span>
            <span class="text-dark"><%= @booking.user.email %></span>
          </div>
          <% if @booking.user.phone.present? %>
            <div class="flex justify-between items-center text-sm">
              <span class="text-gray-500">Телефон:</span>
              <span class="text-dark"><%= @booking.user.phone %></span>
            </div>
          <% end %>
        </div>

        <% if @booking.guest_name.present? %>
          <div class="mt-4 pt-4 border-t border-gray-200/60 space-y-2">
            <h4 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-3">Данные для заселения</h4>
            <div class="flex justify-between items-center text-sm">
              <span class="text-gray-500">ФИО гостя:</span>
              <span class="font-bold text-dark"><%= @booking.guest_name %></span>
            </div>
            <div class="flex justify-between items-center text-sm">
              <span class="text-gray-500">Телефон:</span>
              <span class="text-dark"><%= @booking.guest_phone %></span>
            </div>
            <div class="flex justify-between items-center text-sm">
              <span class="text-gray-500">Паспорт:</span>
              <span class="text-dark"><%= @booking.guest_passport %></span>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Информация об объекте и проживании -->
      <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100 flex flex-col justify-between">
        <div>
          <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-4">Объект и размещение</h3>
          <div class="space-y-3">
            <div>
              <div class="text-sm font-bold text-dark"><%= @booking.room.hotel.name %></div>
              <div class="text-xs text-gray-500 mt-0.5"><%= @booking.room.hotel.full_address %></div>
            </div>
            <div class="pt-2 border-t border-gray-200/60 text-sm">
              <span class="text-gray-500">Номер:</span>
              <span class="font-bold text-dark"><%= @booking.room.name %> (<%= @booking.room.room_type %>)</span>
            </div>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-gray-200/60 grid grid-cols-2 gap-4">
          <div>
            <div class="text-xs text-gray-500">Заезд</div>
            <div class="text-sm font-bold text-dark"><%= @booking.check_in.strftime('%d.%m.%Y') %></div>
          </div>
          <div>
            <div class="text-xs text-gray-500">Выезд</div>
            <div class="text-sm font-bold text-dark"><%= @booking.check_out.strftime('%d.%m.%Y') %></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Стоимость и параметры -->
    <div class="px-8 py-6 bg-gray-50 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b border-gray-100">
      <div>
        <div class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-1">Итоговая стоимость</div>
        <div class="flex items-baseline gap-2">
          <span class="text-3xl font-extrabold text-primary"><%= number_to_currency(@booking.total_price, unit: '₽', format: '%n %u', precision: 0) %></span>
          <span class="text-sm text-gray-500">(<%= @booking.nights_count %> ночей, <%= @booking.guests_count %> гостей)</span>
        </div>
      </div>
      <div class="text-right">
        <div class="text-xs text-gray-400">Тариф за ночь</div>
        <div class="text-sm font-bold text-dark"><%= number_to_currency(@booking.price_per_night, unit: '₽', format: '%n %u', precision: 0) %> / ночь</div>
      </div>
    </div>

    <% if @booking.special_requests.present? %>
      <div class="px-8 pb-6">
        <h3 class="text-sm font-bold text-gray-400 uppercase tracking-wider mb-2">Особые пожелания</h3>
        <p class="text-gray-600 bg-gray-50 rounded-xl p-4"><%= @booking.special_requests %></p>
      </div>
    <% end %>

    <!-- Действия -->
    <% if @booking.pending? || @booking.confirmed? %>
      <div class="px-8 py-6 bg-gray-50 border-t border-gray-100 flex gap-3">
        <% if @booking.pending? %>
          <button onclick="openConfirmModal()" class="bg-green-600 hover:bg-green-700 text-white font-bold px-6 py-3 rounded-xl transition-colors cursor-pointer">
            Подтвердить бронирование
          </button>
          <button onclick="openCancelModal()" class="bg-red-600 hover:bg-red-700 text-white font-bold px-6 py-3 rounded-xl transition-colors cursor-pointer">
            Отклонить бронирование
          </button>
        <% elsif @booking.confirmed? %>
          <button onclick="openCancelModal()" class="bg-red-600 hover:bg-red-700 text-white font-bold px-6 py-3 rounded-xl transition-colors cursor-pointer">
            Отменить бронирование
          </button>
        <% end %>
      </div>

      <!-- Кастомное модальное окно подтверждения -->
      <div id="confirm-modal" class="fixed inset-0 z-50 flex items-center justify-center hidden">
        <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" onclick="closeConfirmModal()"></div>
        <div class="relative bg-white rounded-3xl p-8 max-w-sm w-full mx-4 shadow-2xl border border-gray-100 text-center animate-in fade-in zoom-in duration-200">
          <div class="w-16 h-16 bg-green-50 text-green-500 rounded-full flex items-center justify-center mx-auto mb-4 border border-green-100">
            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-dark mb-2">Подтвердить бронирование?</h3>
          <p class="text-gray-500 text-sm mb-6 leading-relaxed">
            Вы собираетесь подтвердить бронирование #<%= @booking.id %> для гостя <%= @booking.user.full_name %>.
          </p>
          <div class="flex gap-3">
            <button onclick="closeConfirmModal()" class="flex-1 bg-gray-50 hover:bg-gray-100 text-dark font-bold py-3 px-4 rounded-xl transition-colors border border-gray-200 text-sm cursor-pointer">
              Назад
            </button>
            <%= button_to 'Подтвердить', confirm_supervisor_booking_path(@booking), method: :patch, form: { class: 'flex-1' }, class: 'w-full bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-4 rounded-xl transition-colors text-sm cursor-pointer' %>
          </div>
        </div>
      </div>

      <!-- Кастомное модальное окно отмены -->
      <div id="cancel-modal" class="fixed inset-0 z-50 flex items-center justify-center hidden">
        <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" onclick="closeCancelModal()"></div>
        <div class="relative bg-white rounded-3xl p-8 max-w-md w-full mx-4 shadow-2xl border border-gray-100 text-left animate-in fade-in zoom-in duration-200">
          <div class="w-12 h-12 bg-red-50 text-red-500 rounded-full flex items-center justify-center mb-4 border border-red-100">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-dark mb-2">
            <%= @booking.pending? ? 'Отклонить запрос?' : 'Отменить бронирование?' %>
          </h3>
          <p class="text-gray-500 text-sm mb-4 leading-relaxed">
            Укажите причину для отправки клиенту. Она отобразится в его личном кабинете.
          </p>

          <%= form_with url: cancel_supervisor_booking_path(@booking), method: :patch, local: true, class: "space-y-4" do %>
            <div>
              <label class="block text-xs font-bold text-gray-400 uppercase mb-2">Выберите причину</label>
              <select id="cancel_reason_preset" class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-primary text-dark text-sm bg-white" onchange="toggleCustomReason(this)">
                <option value="Нет свободных номеров на выбранные даты">Нет свободных номеров на выбранные даты</option>
                <option value="Технические неполадки / Ремонт в корпусе">Технические неполадки / Ремонт в корпусе</option>
                <option value="Форс-мажорные обстоятельства">Форс-мажорные обстоятельства</option>
                <option value="other">Другая причина...</option>
              </select>
            </div>

            <div id="custom_reason_wrapper" class="hidden">
              <label class="block text-xs font-bold text-gray-400 uppercase mb-2">Свой вариант</label>
              <textarea name="cancellation_reason" id="custom_reason_input" rows="3" class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-primary text-dark text-sm placeholder-gray-400" placeholder="Укажите причину отмены..."></textarea>
            </div>

            <input type="hidden" name="cancellation_reason" id="final_reason_input" value="Нет свободных номеров на выбранные даты">

            <div class="flex gap-3 pt-2">
              <button type="button" onclick="closeCancelModal()" class="flex-1 bg-gray-50 hover:bg-gray-100 text-dark font-bold py-3 px-4 rounded-xl transition-colors border border-gray-200 text-sm cursor-pointer text-center">
                Назад
              </button>
              <button type="submit" class="flex-1 bg-red-600 hover:bg-red-700 text-white font-bold py-3 px-4 rounded-xl transition-colors text-sm cursor-pointer">
                Подтвердить отмену
              </button>
            </div>
          <% end %>
        </div>
      </div>

      <script>
        function openConfirmModal() {
          const modal = document.getElementById('confirm-modal');
          if (modal) {
            modal.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
          }
        }

        function closeConfirmModal() {
          const modal = document.getElementById('confirm-modal');
          if (modal) {
            modal.classList.add('hidden');
            document.body.style.overflow = '';
          }
        }

        function openCancelModal() {
          const modal = document.getElementById('cancel-modal');
          if (modal) {
            modal.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
          }
        }

        function closeCancelModal() {
          const modal = document.getElementById('cancel-modal');
          if (modal) {
            modal.classList.add('hidden');
            document.body.style.overflow = '';
          }
        }

        function toggleCustomReason(select) {
          const wrapper = document.getElementById('custom_reason_wrapper');
          const customInput = document.getElementById('custom_reason_input');
          const finalInput = document.getElementById('final_reason_input');
          
          if (select.value === 'other') {
            wrapper.classList.remove('hidden');
            customInput.required = true;
            finalInput.name = '';
            customInput.name = 'cancellation_reason';
          } else {
            wrapper.classList.add('hidden');
            customInput.required = false;
            finalInput.name = 'cancellation_reason';
            customInput.name = '';
            finalInput.value = select.value;
          }
        }
      </script>
    <% end %>
  </div>
</div>
