<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <!-- Навигация -->
  <div class="mb-6">
    <%= link_to '← Назад к бронированиям', supervisor_bookings_path, class: 'text-primary hover:text-primary-dark font-medium text-sm' %>
  </div>

  <!-- Карточка бронирования -->
  <div class="bg-white rounded-2xl shadow-card overflow-hidden">
    <!-- Заголовок -->
    <div class="px-8 py-6 border-b border-gray-100 flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold text-dark">Бронирование #<%= @booking.id %></h1>
        <p class="text-gray-500 text-sm mt-1">Создано: <%= @booking.created_at.strftime('%d.%m.%Y в %H:%M') %></p>
      </div>
      <% status_colors = { 'pending' => 'bg-yellow-100 text-yellow-800', 'confirmed' => 'bg-green-100 text-green-800', 'cancelled' => 'bg-red-100 text-red-800', 'completed' => 'bg-blue-100 text-blue-800' } %>
      <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-semibold <%= status_colors[@booking.status] %>">
        <%= @booking.status_label %>
      </span>
    </div>

    <div class="p-8 grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Информация о госте -->
      <div>
        <h3 class="text-sm font-bold text-gray-400 uppercase tracking-wider mb-3">Гость</h3>
        <p class="text-lg font-semibold text-dark"><%= @booking.user.full_name %></p>
        <p class="text-gray-500"><%= @booking.user.email %></p>
        <% if @booking.user.phone.present? %>
          <p class="text-gray-500"><%= @booking.user.phone %></p>
        <% end %>
      </div>

      <!-- Информация об объекте -->
      <div>
        <h3 class="text-sm font-bold text-gray-400 uppercase tracking-wider mb-3">Объект</h3>
        <p class="text-lg font-semibold text-dark"><%= @booking.room.hotel.name %></p>
        <p class="text-gray-500"><%= @booking.room.short_info %></p>
        <p class="text-gray-500"><%= @booking.room.hotel.full_address %></p>
      </div>

      <!-- Даты -->
      <div>
        <h3 class="text-sm font-bold text-gray-400 uppercase tracking-wider mb-3">Даты проживания</h3>
        <p class="text-dark font-medium">
          <%= @booking.check_in.strftime('%d.%m.%Y') %> → <%= @booking.check_out.strftime('%d.%m.%Y') %>
        </p>
        <p class="text-gray-500"><%= @booking.nights_count %> ночей, <%= @booking.guests_count %> гостей</p>
      </div>

      <!-- Стоимость -->
      <div>
        <h3 class="text-sm font-bold text-gray-400 uppercase tracking-wider mb-3">Стоимость</h3>
        <p class="text-2xl font-bold text-primary"><%= number_to_currency(@booking.total_price, unit: '₽', format: '%n %u', precision: 0) %></p>
        <p class="text-gray-500"><%= number_to_currency(@booking.price_per_night, unit: '₽', format: '%n %u', precision: 0) %> / ночь</p>
      </div>
    </div>

    <% if @booking.special_requests.present? %>
      <div class="px-8 pb-6">
        <h3 class="text-sm font-bold text-gray-400 uppercase tracking-wider mb-2">Особые пожелания</h3>
        <p class="text-gray-600 bg-gray-50 rounded-xl p-4"><%= @booking.special_requests %></p>
      </div>
    <% end %>

    <!-- Действия -->
    <% if @booking.pending? || @booking.confirmed? %>
      <div class="px-8 py-6 bg-gray-50 border-t border-gray-100 flex gap-3">
        <% if @booking.pending? %>
          <%= button_to 'Подтвердить бронирование', confirm_supervisor_booking_path(@booking), method: :patch,
              class: 'bg-green-600 hover:bg-green-700 text-white font-bold px-6 py-3 rounded-xl transition-colors cursor-pointer',
              onclick: "return confirm('Подтвердить бронирование?')" %>
          <button onclick="openCancelModal()" class="bg-red-600 hover:bg-red-700 text-white font-bold px-6 py-3 rounded-xl transition-colors cursor-pointer">
            Отклонить бронирование
          </button>
        <% elsif @booking.confirmed? %>
          <button onclick="openCancelModal()" class="bg-red-600 hover:bg-red-700 text-white font-bold px-6 py-3 rounded-xl transition-colors cursor-pointer">
            Отменить бронирование
          </button>
        <% end %>
      </div>

      <!-- Красивое модальное окно отмены/отклонения бронирования -->
      <div id="cancel-modal" class="fixed inset-0 z-50 flex items-center justify-center hidden">
        <!-- Backdrop overlay -->
        <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" onclick="closeCancelModal()"></div>
        
        <!-- Modal box -->
        <div class="relative bg-white rounded-3xl p-8 max-w-sm w-full mx-4 shadow-2xl border border-gray-100 text-center animate-in fade-in zoom-in duration-200">
          <div class="w-16 h-16 bg-red-50 text-red-500 rounded-full flex items-center justify-center mx-auto mb-4 border border-red-100">
            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-dark mb-2">
            <%= @booking.pending? ? 'Отклонить бронирование?' : 'Отменить бронирование?' %>
          </h3>
          <p class="text-gray-500 text-sm mb-6 leading-relaxed">
            <%= @booking.pending? ? 'Вы действительно хотите отклонить этот запрос на бронирование?' : 'Вы действительно хотите отменить подтвержденное бронирование?' %>
          </p>
          
          <div class="flex gap-3">
            <button onclick="closeCancelModal()" class="flex-1 bg-gray-50 hover:bg-gray-100 text-dark font-bold py-3 px-4 rounded-xl transition-colors border border-gray-200 text-sm cursor-pointer">
              Назад
            </button>
            <%= button_to (@booking.pending? ? 'Отклонить' : 'Отменить'), cancel_supervisor_booking_path(@booking), method: :patch, form: { class: 'flex-1' }, class: 'w-full bg-red-600 hover:bg-red-700 text-white font-bold py-3 px-4 rounded-xl transition-colors text-sm cursor-pointer' %>
          </div>
        </div>
      </div>

      <script>
        function openCancelModal() {
          const modal = document.getElementById('cancel-modal');
          if (modal) {
            modal.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
          }
        }

        doc = document;
        function closeCancelModal() {
          const modal = document.getElementById('cancel-modal');
          if (modal) {
            modal.classList.add('hidden');
            document.body.style.overflow = '';
          }
        }
      </script>
    <% end %>
  </div>
</div>
