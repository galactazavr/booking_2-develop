<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <div class="mb-6">
    <%= link_to '← Назад к отелю', hotel_path(@hotel), class: 'text-primary hover:text-primary-dark font-medium text-sm' %>
  </div>

  <div class="mb-8">
    <h1 class="text-3xl font-bold text-dark">Номера — <%= @hotel.name %></h1>
    <p class="text-gray-500 mt-1"><%= @hotel.full_address %></p>
  </div>

  <% if @rooms.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @rooms.each do |room| %>
        <div class="bg-white rounded-2xl shadow-card hover:shadow-card-hover transition-shadow overflow-hidden">
          <div class="h-48 bg-gradient-to-br from-primary/10 to-primary/5 flex items-center justify-center">
            <svg class="w-16 h-16 text-primary/30" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
          </div>
          <div class="p-6">
            <div class="flex items-start justify-between mb-2">
              <h3 class="text-lg font-bold text-dark"><%= room.name %></h3>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-primary-light text-primary">
                <%= room.room_type %>
              </span>
            </div>
            <div class="flex items-center gap-4 text-sm text-gray-500 mb-3">
              <span>👥 до <%= room.capacity %> чел.</span>
              <span>📐 <%= room.area %> м²</span>
            </div>
            <% if room.description.present? %>
              <p class="text-sm text-gray-500 mb-4 line-clamp-2"><%= room.description %></p>
            <% end %>
            <div class="flex items-center justify-between pt-3 border-t border-gray-100">
              <span class="text-xl font-bold text-primary"><%= room.formatted_price %></span>
              <%= link_to 'Подробнее', hotel_room_path(@hotel, room), class: 'text-primary hover:text-primary-dark font-medium text-sm' %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white rounded-2xl shadow-card p-12 text-center">
      <h3 class="text-lg font-semibold text-gray-500">Номеров пока нет</h3>
    </div>
  <% end %>
</div>
