<!-- Навигационная панель Отели.ру -->
<header class="sticky top-0 z-50 bg-white border-b border-gray-100 shadow-nav">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20 relative">
      
      <!-- Логотип -->
      <div class="flex-shrink-0 flex items-center cursor-pointer" onclick="window.location.href='/'">
        <svg class="h-8 w-auto text-primary mr-2" fill="currentColor" viewBox="0 0 24 24">
          <path d="M19 7h-3V6a4 4 0 0 0-8 0v1H5a1 1 0 0 0-1 1v11a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V8a1 1 0 0 0-1-1zm-9-1a2 2 0 0 1 4 0v1h-4V6zm8 13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V9h2v1a1 1 0 0 0 2 0V9h4v1a1 1 0 0 0 2 0V9h2v10z"/>
        </svg>
        <span class="font-bold text-2xl tracking-tight text-primary">Отели<span class="text-secondary">.ру</span></span>
      </div>

      <!-- Центральное меню -->
      <nav class="hidden md:flex absolute left-1/2 -translate-x-1/2 space-x-8">
        <a href="/" class="text-dark font-medium hover:text-primary transition-colors py-2">Главная</a>
        <a href="/search" class="text-dark font-medium hover:text-primary transition-colors py-2">Найти отель</a>
        <a href="/favorites" class="text-dark font-medium hover:text-primary transition-colors py-2">Избранное</a>
      </nav>

      <!-- Меню пользователя -->
      <div class="flex items-center space-x-4">
        <!-- Кнопка Избранное для мобильных -->
        <a href="/favorites" class="md:hidden p-2 text-gray-400 hover:text-secondary transition-colors">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
          </svg>
        </a>

        <% if user_signed_in? %>
          <div class="relative group">
            <button class="flex items-center space-x-2 border border-gray-200 rounded-full px-3 py-2 bg-white hover:shadow-md transition-shadow">
              <svg class="w-5 h-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
              <div class="w-8 h-8 rounded-full bg-primary-light flex items-center justify-center text-primary font-bold text-sm">
                <%= current_user.email[0].upcase %>
              </div>
            </button>
            
            <!-- Выпадающее меню (появляется при наведении) -->
            <div class="absolute right-0 mt-2 w-48 bg-white rounded-xl shadow-lg py-2 border border-gray-100 hidden group-hover:block before:content-[''] before:absolute before:-top-2 before:left-0 before:w-full before:h-2">
              <% if current_user.admin? %>
                <a href="/admin" class="block px-4 py-2 text-sm font-bold text-primary hover:bg-gray-50">Админ-панель</a>
              <% else %>
                <% if current_user.supervisor? %>
                  <a href="/supervisor" class="block px-4 py-2 text-sm text-dark hover:bg-gray-50">Супервайзор</a>
                <% end %>
                <a href="/bookings" class="block px-4 py-2 text-sm text-dark hover:bg-gray-50">Мои бронирования</a>
              <% end %>
              <div class="border-t border-gray-100 my-1"></div>
              <%= button_to "Выйти", destroy_user_session_path, method: :delete, class: "block w-full text-left px-4 py-2 text-sm text-red-600 hover:bg-gray-50", form: { data: { turbo: false } } %>
            </div>
          </div>
        <% else %>
          <div class="hidden sm:flex items-center space-x-4">
            <%= link_to "Войти", new_user_session_path, class: "text-dark font-medium hover:text-primary transition-colors", data: { turbo: false } %>
            <%= link_to "Регистрация", new_user_registration_path, class: "bg-primary text-white px-5 py-2.5 rounded-full font-medium hover:bg-primary-dark transition-colors", data: { turbo: false } %>
          </div>
        <% end %>
      </div>

    </div>
  </div>
</header>
