<!-- Карточка отеля -->
<% card_path = hotel.is_a?(Hotel) ? hotel_path(hotel) : property_path(hotel) %>
<div class="group bg-white rounded-2xl shadow-card hover:shadow-card-hover border border-gray-100 transition-all duration-300 overflow-hidden flex flex-col h-full">
  
  <!-- Изображение -->
  <div class="relative w-full aspect-[4/3] bg-gray-100 overflow-hidden">
    <% if hotel.photos.attached? && hotel.photos.first.present? %>
      <%= image_tag hotel.photos.first, class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-500", alt: hotel.name %>
    <% elsif hotel.respond_to?(:image_url) && hotel.image_url.present? %>
      <img src="<%= hotel.image_url %>" alt="<%= hotel.name %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
    <% else %>
      <!-- Премиум-заглушка с красивым дефолтным фото -->
      <% default_image_url = hotel.is_a?(Property) ? "https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?auto=format&fit=crop&w=600&q=80" : "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=600&q=80" %>
      <img src="<%= default_image_url %>" alt="<%= hotel.name %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
    <% end %>

    <!-- Бейдж статуса -->
    <% if hotel.respond_to?(:rating) && hotel.rating && hotel.rating >= 4.5 %>
      <div class="absolute top-3 left-3 bg-white/95 backdrop-blur shadow-sm px-2.5 py-1 rounded-md text-xs font-bold text-dark flex items-center">
        Гости рекомендуют
      </div>
    <% end %>

    <!-- Кнопка избранного (только для отелей) -->
    <% if hotel.is_a?(Hotel) %>
      <% is_favorited = user_signed_in? && current_user.favorites.exists?(hotel_id: hotel.id) %>
      <button onclick="toggleFav(<%= hotel.id %>); return false;" class="absolute top-3 right-3 p-2 rounded-full bg-white/80 hover:bg-white backdrop-blur shadow-sm transition-colors group/btn">
        <svg class="w-5 h-5 <%= is_favorited ? 'text-secondary' : 'text-gray-500' %> group-hover/btn:text-secondary transition-colors" fill="<%= is_favorited ? 'currentColor' : 'none' %>" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
        </svg>
      </button>
    <% end %>
  </div>

  <!-- Контент карточки -->
  <div class="p-5 flex flex-col flex-grow">
    
    <!-- Заголовок и рейтинг -->
    <div class="flex justify-between items-start gap-2 mb-1">
      <h3 class="font-bold text-lg text-dark leading-tight line-clamp-1">
        <%= link_to hotel.name, card_path, class: "hover:text-primary transition-colors" %>
      </h3>
      
      <div class="flex items-center gap-1 shrink-0 bg-primary-light px-1.5 py-0.5 rounded text-primary">
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
        <span class="text-sm font-bold"><%= (hotel.respond_to?(:rating) && hotel.rating) || '4.5' %></span>
      </div>
    </div>

    <!-- Локация -->
    <div class="text-sm text-gray-400 mb-3 line-clamp-1">
      <%= hotel.city %><% if hotel.address.present? %>, <%= hotel.address %><% end %>
    </div>

    <!-- Краткие фичи (удобства) -->
    <div class="flex flex-wrap gap-2 mb-4 mt-auto">
      <span class="inline-flex items-center text-xs font-medium text-gray-500 bg-gray-50 px-2 py-1 rounded">
        <svg class="w-3 h-3 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0" /></svg>
        Wi-Fi
      </span>
      <span class="inline-flex items-center text-xs font-medium text-gray-500 bg-gray-50 px-2 py-1 rounded">
        <svg class="w-3 h-3 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 15.546c-.523 0-1.046.151-1.5.454a2.704 2.704 0 01-3 0 2.704 2.704 0 00-3 0 2.704 2.704 0 01-3 0 2.704 2.704 0 00-3 0 2.704 2.704 0 01-3 0 2.701 2.701 0 00-1.5-.454M9 6v2m3-2v2m3-2v2M9 3h.01M12 3h.01M15 3h.01M21 21v-7a2 2 0 00-2-2H5a2 2 0 00-2 2v7h18zm-3-9v-2a2 2 0 00-2-2H8a2 2 0 00-2 2v2h12z" /></svg>
        Завтрак
      </span>
      <span class="inline-flex items-center text-xs font-medium text-gray-500 bg-gray-50 px-2 py-1 rounded">
        <svg class="w-3 h-3 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
        Отмена
      </span>
    </div>

    <div class="border-t border-gray-100 my-4"></div>

    <!-- Цена и кнопка -->
    <div class="flex items-end justify-between">
      <div>
        <div class="text-xs text-gray-400 mb-0.5">Цена за ночь от</div>
        <div class="text-xl font-bold text-dark">
          <%= number_to_currency(hotel.display_price, unit: '₽', format: '%n %u', precision: 0) %>
        </div>
      </div>
      
      <%= link_to "Подробнее", card_path, class: "bg-primary hover:bg-primary-dark text-white font-medium text-sm px-4 py-2 rounded-lg transition-colors" %>
    </div>
    
  </div>
</div>
