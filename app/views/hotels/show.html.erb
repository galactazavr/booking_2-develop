<!-- Шапка отеля (название, рейтинг, локация) -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
  <div class="flex justify-between items-start mb-4">
    <div>
      <h1 class="text-3xl font-bold text-dark mb-2"><%= @hotel.name %></h1>
      <div class="flex flex-wrap items-center gap-4 text-sm font-medium text-dark">
        <span class="flex items-center gap-1 text-dark">
          <svg class="w-4 h-4 text-primary" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
          <%= @hotel.average_rating || 4.8 %> · <%= link_to "#{@hotel.reviews.count} отзывов", "#reviews", class: "underline hover:text-gray-500" %>
        </span>
        <span class="flex items-center gap-1 text-gray-500 underline hover:text-dark transition-colors cursor-pointer">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
          <%= @hotel.full_address %>
        </span>
      </div>
    </div>
    
    <div class="flex gap-2 items-center">
      <% if policy(@hotel).destroy? %>
        <button onclick="demolishWithReason('<%= hotel_path(@hotel) %>', '<%= escape_javascript(@hotel.name) %>')" class="flex items-center gap-1.5 px-4 py-2 rounded-lg bg-red-50 hover:bg-red-100 text-red-600 font-bold transition-colors">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
          Снести отель
        </button>

        <script>
          function demolishWithReason(url, name) {
            const reason = prompt(`Вы собираетесь полностью снести отель "${name}". Укажите причину для отправки клиентам с активными бронированиями (необязательно):`);
            if (reason === null) return; // User cancelled
            
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = url;
            
            const token = document.querySelector('meta[name="csrf-token"]');
            if (token) {
              const tokenInput = document.createElement('input');
              tokenInput.type = 'hidden';
              tokenInput.name = 'authenticity_token';
              tokenInput.value = token.content;
              form.appendChild(tokenInput);
            }
            
            const methodInput = document.createElement('input');
            methodInput.type = 'hidden';
            methodInput.name = '_method';
            methodInput.value = 'DELETE';
            form.appendChild(methodInput);
            
            const reasonInput = document.createElement('input');
            reasonInput.type = 'hidden';
            reasonInput.name = 'deletion_reason';
            reasonInput.value = reason;
            form.appendChild(reasonInput);
            
            document.body.appendChild(form);
            form.submit();
          }
        </script>
      <% end %>

      <% is_favorited = user_signed_in? && current_user.favorites.exists?(hotel_id: @hotel.id) %>
      <button onclick="toggleFav(<%= @hotel.id %>); return false;" class="flex items-center gap-2 px-4 py-2 rounded-lg hover:bg-gray-100 font-medium text-dark transition-colors group/btn">
        <svg class="w-5 h-5 <%= is_favorited ? 'text-secondary' : 'text-gray-500' %> group-hover/btn:text-secondary transition-colors" fill="<%= is_favorited ? 'currentColor' : 'none' %>" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
        </svg>
        <span class="<%= is_favorited ? 'text-secondary font-bold' : '' %>"><%= is_favorited ? 'В избранном' : 'Сохранить' %></span>
      </button>
    </div>
  </div>

  <!-- Галерея фото -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-2 h-[40vh] md:h-[60vh] rounded-2xl overflow-hidden mb-12">
    <% if @hotel.photos.attached? %>
      <div class="col-span-1 md:col-span-2 row-span-2 h-full">
        <%= image_tag @hotel.photos[0], class: "w-full h-full object-cover hover:opacity-90 transition-opacity cursor-pointer" %>
      </div>
      <% @hotel.photos[1..4].each do |photo| %>
        <div class="col-span-1 h-full hidden md:block">
          <%= image_tag photo, class: "w-full h-full object-cover hover:opacity-90 transition-opacity cursor-pointer" %>
        </div>
      <% end %>
    <% elsif @hotel.image_url.present? %>
      <div class="col-span-1 md:col-span-2 row-span-2 h-full">
        <img src="<%= @hotel.image_url %>" class="w-full h-full object-cover hover:opacity-90 transition-opacity cursor-pointer" alt="<%= @hotel.name %>">
      </div>
      <div class="col-span-1 h-full hidden md:block">
        <img src="https://images.unsplash.com/photo-1590490360182-c33d57733427?auto=format&fit=crop&w=600&q=80" class="w-full h-full object-cover hover:opacity-90 transition-opacity cursor-pointer">
      </div>
      <div class="col-span-1 h-full hidden md:block">
        <img src="https://images.unsplash.com/photo-1595576508898-0ad5c879a061?auto=format&fit=crop&w=600&q=80" class="w-full h-full object-cover hover:opacity-90 transition-opacity cursor-pointer">
      </div>
      <div class="col-span-1 h-full hidden md:block">
        <img src="https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=600&q=80" class="w-full h-full object-cover hover:opacity-90 transition-opacity cursor-pointer">
      </div>
      <div class="col-span-1 h-full hidden md:block">
        <img src="https://images.unsplash.com/photo-1618773928121-c32242e63f39?auto=format&fit=crop&w=600&q=80" class="w-full h-full object-cover hover:opacity-90 transition-opacity cursor-pointer">
      </div>
    <% else %>
      <div class="col-span-1 md:col-span-2 row-span-2 h-full bg-gray-200 flex items-center justify-center">
        <span class="text-4xl text-gray-400">🏨</span>
      </div>
      <div class="col-span-1 h-full hidden md:block bg-gray-100"></div>
      <div class="col-span-1 h-full hidden md:block bg-gray-100"></div>
      <div class="col-span-1 h-full hidden md:block bg-gray-100"></div>
      <div class="col-span-1 h-full hidden md:block bg-gray-100"></div>
    <% end %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 relative">
    
    <!-- Левая колонка (Описание и номера) -->
    <div class="lg:col-span-2">
      
      <!-- Основное описание -->
      <div class="border-b border-gray-200 pb-8 mb-8">
        <h2 class="text-2xl font-bold text-dark mb-4">Об отеле</h2>
        <div class="text-gray-600 leading-relaxed text-lg">
          <% if @hotel.description.present? %>
            <%= simple_format(@hotel.description) %>
          <% else %>
            <p>Прекрасный отель, расположенный в самом сердце города. Идеально подходит как для деловых поездок, так и для отдыха. К услугам гостей комфортабельные номера со всеми удобствами.</p>
          <% end %>
        </div>
      </div>

      <!-- Удобства (Фичи) -->
      <div class="border-b border-gray-200 pb-8 mb-8">
        <h2 class="text-2xl font-bold text-dark mb-6">Что вас ждет</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-y-4 gap-x-8">
          <% ( @hotel.amenities.presence || ['Wi-Fi', 'Парковка', 'Бассейн', 'Кондиционер'] ).each do |amenity| %>
            <div class="flex items-center gap-3 text-dark text-lg">
              <span class="text-2xl">
                <% case amenity.downcase.strip
                   when 'wi-fi', 'wifi', 'вайфай', 'интернет' then '📶'
                   when 'парковка', 'автостоянка', 'parking' then '🅿️'
                   when 'бассейн', 'pool' then '🏊'
                   when 'кондиционер', 'ac', 'охлаждение' then '❄️'
                   when 'телевизор', 'tv' then '📺'
                   when 'завтрак', 'breakfast', 'еда' then '🍳'
                   when 'ресторан', 'restaurant' then '🍽️'
                   when 'бар', 'bar' then '🍹'
                   when 'спа', 'spa' then '💆'
                   when 'спортзал', 'gym', 'фитнес' then '💪'
                   else '✓'
                   end %>
              </span>
              <span><%= amenity %></span>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Правила проживания и заезд/выезд -->
      <div class="border-b border-gray-200 pb-8 mb-8">
        <h2 class="text-2xl font-bold text-dark mb-6">Правила проживания</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 bg-gray-50 p-6 rounded-2xl border border-gray-100 mb-6">
          <div>
            <div class="text-sm text-gray-500 font-bold uppercase tracking-wide mb-1">⏱ Время заезда</div>
            <div class="text-lg font-semibold text-dark">с <%= @hotel.check_in_time.presence || '14:00' %></div>
          </div>
          <div>
            <div class="text-sm text-gray-500 font-bold uppercase tracking-wide mb-1">⏱ Время выезда</div>
            <div class="text-lg font-semibold text-dark">до <%= @hotel.check_out_time.presence || '12:00' %></div>
          </div>
        </div>
        <% if @hotel.rules.present? %>
          <div class="text-gray-600 leading-relaxed whitespace-pre-wrap"><%= @hotel.rules %></div>
        <% else %>
          <div class="text-gray-500 italic">Специальных правил проживания не установлено. Разрешено проживание с детьми. Проживание с животными требует согласования.</div>
        <% end %>
      </div>

      <!-- Список номеров -->
      <div>
        <h2 class="text-2xl font-bold text-dark mb-6">Доступные номера</h2>
        <% if @rooms.any? %>
          <div class="space-y-4">
            <% @rooms.each do |room| %>
              <div class="border border-gray-200 rounded-2xl p-6 flex flex-col md:flex-row gap-6 hover:shadow-card transition-shadow bg-white">
                <div class="w-full md:w-48 aspect-[4/3] rounded-xl overflow-hidden bg-gray-100 shrink-0 shadow-sm border border-gray-100">
                  <% if room.photos.attached? && room.photos.first.present? %>
                    <%= image_tag room.photos.first, class: "w-full h-full object-cover hover:scale-105 transition-transform duration-500", alt: room.name %>
                  <% else %>
                    <img src="<%= room.image_url.presence || "https://images.unsplash.com/photo-1590490360182-c33d57733427?auto=format&fit=crop&w=400&q=80" %>" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" alt="<%= room.name %>">
                  <% end %>
                </div>
                <div class="flex-1 flex flex-col justify-between">
                  <div>
                    <h3 class="text-xl font-bold text-dark mb-2"><%= room.name %></h3>
                    <div class="text-gray-500 mb-3 text-sm flex flex-wrap gap-x-4 gap-y-2">
                      <span class="flex items-center gap-1"><svg class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg> до <%= room.capacity %> гостей</span>
                      <span class="flex items-center gap-1"><svg class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" /></svg> <%= room.area %> м²</span>
                      <span class="flex items-center gap-1"><svg class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg> <%= room.room_type %></span>
                      <span class="flex items-center gap-1"><svg class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg> Вид: <%= room.view_type.presence || 'Во двор' %></span>
                    </div>
                    <% if room.description.present? %>
                      <p class="text-gray-600 text-sm mb-3 line-clamp-2"><%= room.description %></p>
                    <% end %>
                  </div>
                  
                  <div class="flex flex-wrap gap-1.5 mt-2">
                    <% (room.amenities.presence || ['Wi-Fi', 'Телевизор', 'Собственная ванная']).each do |amenity| %>
                      <span class="inline-flex items-center text-xs font-semibold text-gray-500 bg-gray-50 border border-gray-200 px-2 py-0.5 rounded-md">
                        <%= amenity %>
                      </span>
                    <% end %>
                  </div>
                </div>
                
                <div class="md:w-48 flex flex-col justify-end border-t md:border-t-0 md:border-l border-gray-100 pt-4 md:pt-0 md:pl-6">
                  <div class="text-xs text-gray-500 mb-1">За 1 ночь</div>
                  <div class="text-2xl font-bold text-dark mb-4"><%= number_to_currency(room.price_per_night, unit: '₽', format: '%n %u', precision: 0) %></div>
                  
                  <%= link_to "Выбрать", new_booking_path(room_id: room.id, check_in: params[:check_in] || Date.tomorrow, check_out: params[:check_out] || 2.days.from_now.to_date, guests: params[:guests] || 2), class: "w-full text-center bg-primary hover:bg-primary-dark text-white font-bold py-3 px-4 rounded-xl transition-colors" %>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="bg-gray-50 rounded-2xl p-8 text-center border border-gray-100">
            <p class="text-gray-500 text-lg">Нет доступных номеров на выбранные даты.</p>
          </div>
        <% end %>
      </div>

    </div>

    <!-- Правая колонка (Плавающий виджет цен) -->
    <div class="lg:col-span-1">
      <div class="sticky top-28 bg-white border border-gray-200 shadow-card rounded-2xl p-6">
        <div class="flex items-baseline gap-1 mb-6">
          <span class="text-2xl font-bold text-dark">От <%= number_to_currency(@hotel.display_price, unit: '₽', format: '%n %u', precision: 0) %></span>
          <span class="text-gray-500">ночь</span>
        </div>

        <div class="border border-gray-300 rounded-xl overflow-hidden mb-4 bg-white">
          <div class="flex border-b border-gray-300">
            <div class="flex-1 p-3 border-r border-gray-300">
              <div class="text-xs font-bold text-dark uppercase tracking-wide">Заезд</div>
              <div class="text-sm text-gray-600 mt-1"><%= params[:check_in] || Date.tomorrow.strftime('%d.%m.%Y') %></div>
            </div>
            <div class="flex-1 p-3">
              <div class="text-xs font-bold text-dark uppercase tracking-wide">Выезд</div>
              <div class="text-sm text-gray-600 mt-1"><%= params[:check_out] || 2.days.from_now.strftime('%d.%m.%Y') %></div>
            </div>
          </div>
          <div class="p-3">
            <div class="text-xs font-bold text-dark uppercase tracking-wide">Гости</div>
            <div class="text-sm text-gray-600 mt-1"><%= params[:guests] || 2 %> гостя</div>
          </div>
        </div>

        <button onclick="document.querySelector('.space-y-4').scrollIntoView({behavior: 'smooth'})" class="w-full bg-primary hover:bg-primary-dark text-white font-bold py-3.5 px-4 rounded-xl transition-colors text-lg mb-4">
          Проверить наличие
        </button>
        <p class="text-center text-sm text-gray-500">Пока вы ни за что не платите</p>
      </div>
    </div>

  </div>
</div>

<!-- Секция Отзывов -->
<div id="reviews" class="border-t border-gray-200 mt-16 bg-gray-50 py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <%= render partial: 'reviews/reviews_section', locals: { hotel: @hotel } %>
  </div>
</div>

<script>
  function toggleFav(id){
    fetch('/favorites/toggle/' + id, {
      method: 'POST',
      headers: {
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content,
        'Content-Type': 'application/json'
      }
    }).then(() => {
      location.reload();
    });
  }
</script>
